#!/usr/bin/env python3
"""Thin shim for non-pip installs (git clone + ./install.sh).
Delegates to the clisweave package under ../src.
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "src"))

from clisweave.cli import main  # noqa: E402

if __name__ == "__main__":
    main()
